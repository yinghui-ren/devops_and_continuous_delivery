// Lab 3 HARD — CI/CD pipeline that runs an Ansible playbook
//
// Jenkins runs as the 'jenkins' user. All ansible commands are executed
// via 'sudo -u vagrant' because the vagrant user has the SSH keys,
// ansible config, and Ansible Galaxy roles already set up.

pipeline {
    agent any

    environment {
        ANSIBLE_DIR = "/home/vagrant/ansible-lab3"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Sync Playbooks') {
            steps {
                sh '''
                    sudo -u vagrant mkdir -p ${ANSIBLE_DIR}/playbooks
                    sudo -u vagrant cp $WORKSPACE/lab3/ansible.cfg ${ANSIBLE_DIR}/
                    sudo -u vagrant cp $WORKSPACE/lab3/inventory.ini ${ANSIBLE_DIR}/
                    sudo -u vagrant cp $WORKSPACE/lab3/playbooks/*.yml ${ANSIBLE_DIR}/playbooks/
                    sudo -u vagrant cp $WORKSPACE/lab3/playbooks/*.yml ${ANSIBLE_DIR}/playbooks/
                '''
            }
        }

        stage('Install System Package') {
            steps {
                sh '''
                    cd ${ANSIBLE_DIR}
                    sudo -u vagrant ansible-playbook playbooks/install-package.yml
                '''
            }
        }

        stage('Manage Package (Install)') {
            steps {
                sh '''
                    cd ${ANSIBLE_DIR}
                    sudo -u vagrant ansible-playbook playbooks/manage-package.yml --tags install
                '''
            }
        }

        stage('Deploy App via Galaxy') {
            steps {
                sh '''
                    cd ${ANSIBLE_DIR}
                    sudo -u vagrant ansible-galaxy install -r playbooks/galaxy-requirements.yml --roles-path ${ANSIBLE_DIR}/roles || true
                    sudo -u vagrant ansible-playbook playbooks/galaxy-nginx.yml
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    cd ${ANSIBLE_DIR}
                    sudo -u vagrant ansible managed_nodes -m ping
                    echo "All checks passed. Ansible playbooks executed successfully via Jenkins CI/CD."
                '''
            }
        }
    }

    post {
        success {
            echo "Lab3 HARD pipeline SUCCESS: Ansible playbook executed via Jenkins CI/CD."
        }
        failure {
            echo "Pipeline failed. Check console output for details."
        }
    }
}
