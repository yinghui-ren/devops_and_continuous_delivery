// Lab 3 HARD — CI/CD pipeline that runs an Ansible playbook
//
// Jenkins runs as the 'jenkins' user. All ansible commands are executed
// via 'sudo -u vagrant bash -c' because the vagrant user has the SSH keys,
// ansible config, and Ansible Galaxy roles already set up.

pipeline {
    agent any

    environment {
        ANSIBLE_DIR = "/home/vagrant/ansible-lab3"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Sync Playbooks') {
            steps {
                sh '''
                    sudo -u vagrant mkdir -p ${ANSIBLE_DIR}/playbooks
                    sudo -u vagrant cp -r $WORKSPACE/lab3/ansible.cfg \
                        $WORKSPACE/lab3/inventory.ini \
                        ${ANSIBLE_DIR}/
                    sudo -u vagrant cp -r $WORKSPACE/lab3/playbooks/*.yml ${ANSIBLE_DIR}/playbooks/
                '''
            }
        }

        stage('Install System Package') {
            steps {
                sh "sudo -u vagrant bash -c 'cd ${ANSIBLE_DIR} && ansible-playbook playbooks/install-package.yml'"
            }
        }

        stage('Manage Package (Install)') {
            steps {
                sh "sudo -u vagrant bash -c 'cd ${ANSIBLE_DIR} && ansible-playbook playbooks/manage-package.yml --tags install'"
            }
        }

        stage('Deploy App via Galaxy') {
            steps {
                sh "sudo -u vagrant bash -c 'cd ${ANSIBLE_DIR} && ansible-galaxy install -r playbooks/galaxy-requirements.yml --roles-path ${ANSIBLE_DIR}/roles || true && ansible-playbook playbooks/galaxy-nginx.yml'"
            }
        }

        stage('Verify') {
            steps {
                sh "sudo -u vagrant bash -c 'cd ${ANSIBLE_DIR} && ansible managed_nodes -m ping && echo All checks passed'"
            }
        }
    }

    post {
        success {
            echo "Lab3 HARD pipeline SUCCESS: Ansible playbook executed via Jenkins CI/CD."
        }
        failure {
            echo "Pipeline failed. Check console output for details."
        }
    }
}
